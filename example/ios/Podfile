# Uncomment this line to define a global platform for your project
platform :ios, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  derived_data_path = File.expand_path('~/Library/Developer/Xcode/DerivedData')
  xcode_builds = Dir.glob("#{derived_data_path}/*/Build/Products")
  xcode_builds.max_by { |dir| File.mtime(dir) }
end

def flutter_install_ios_plugin_pods(ios_application_path)
  Dir.glob(File.join(ios_application_path, '.symlinks', 'plugins', '**')).each do |path|
    podspec_path = File.join(path, '*.podspec')
    podspec = Dir.glob(podspec_path).first
    if podspec
      pod_name = File.basename(File.dirname(podspec), '.podspec')
      pod pod_name.to_s, :path => path
    end
  end
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_ios_plugin_pods File.expand_path('..', __FILE__)
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
    end
  end
end
